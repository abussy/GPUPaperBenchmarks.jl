! Generated from the corresponding DFTK benchmark setup.
! DFTK uses Hartree; QE cutoffs and smearing below use Rydberg.
&CONTROL
  calculation = 'scf'
  prefix = 'silicon_supercell'
  pseudo_dir = './pseudo/'
  outdir = './out/'
  tprnfor = .false.
  tstress = .false.
  disk_io = 'none'
/

&SYSTEM
  ibrav = 0
  nat = 64
  ntyp = 1
  ecutwfc = 36.0000000000
  ecutrho = 144.0000000000
  nr1 = 96
  nr2 = 96
  nr3 = 96
  input_dft = 'PBE'
  occupations = 'fixed'
  nspin = 1
/

&ELECTRONS
  conv_thr = 2.0d-10
  scf_must_converge = .true.
/

ATOMIC_SPECIES
  Si  28.08500000  Si.upf

