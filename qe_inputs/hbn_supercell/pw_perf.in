! Generated from the corresponding DFTK benchmark setup.
! DFTK uses Hartree; QE cutoffs and smearing below use Rydberg.
&CONTROL
  calculation = 'scf'
  prefix = 'hbn_supercell'
  pseudo_dir = './pseudo/'
  outdir = './out/'
  tprnfor = .true.
  tstress = .false.
  disk_io = 'none'
/

&SYSTEM
  ibrav = 0
  nat = 32
  ntyp = 2
  ecutwfc = 84.0000000000
  ecutrho = 336.0000000000
  nr1 = 120
  nr2 = 120
  nr3 = 240
  input_dft = 'PBE'
  occupations = 'fixed'
  nspin = 1
/

&ELECTRONS
  electron_maxstep = 10
  conv_thr = 0.0d0
  scf_must_converge = .false.
/

