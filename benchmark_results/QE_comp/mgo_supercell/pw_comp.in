! Generated from the corresponding DFTK benchmark setup.
! DFTK uses Hartree; QE cutoffs and smearing below use Rydberg.
&CONTROL
  calculation = 'scf'
  prefix = 'mgo_supercell'
  pseudo_dir = './pseudo/'
  outdir = './out/'
  tprnfor = .false.
  tstress = .false.
  disk_io = 'none'
/

&SYSTEM
  ibrav = 0
  nat = 64
  ntyp = 2
  ecutwfc = 84.0000000000
  ecutrho = 336.0000000000
  nr1 = 96
  nr2 = 96
  nr3 = 96
  input_dft = 'PBE'
  occupations = 'fixed'
  nspin = 1
/

&ELECTRONS
  conv_thr = 2.0d-10
  scf_must_converge = .true.
/

ATOMIC_SPECIES
  Mg  24.30500000  Mg.upf
  O  15.99900000  O.upf

