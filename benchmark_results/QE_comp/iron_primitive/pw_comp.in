! Generated from the corresponding DFTK benchmark setup.
! DFTK uses Hartree; QE cutoffs and smearing below use Rydberg.
&CONTROL
  calculation = 'scf'
  prefix = 'iron_primitive'
  pseudo_dir = './pseudo/'
  outdir = './out/'
  tprnfor = .false.
  tstress = .false.
  disk_io = 'none'
/

&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1
  ecutwfc = 90.0000000000
  ecutrho = 360.0000000000
  nr1 = 32
  nr2 = 32
  nr3 = 32
  input_dft = 'PBE'
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 2.000000000000e-02
  nspin = 2
  starting_magnetization(1) = 4.000000000000
/

&ELECTRONS
  conv_thr = 2.0d-10
  scf_must_converge = .true.
/

ATOMIC_SPECIES
  Fe  55.84500000  Fe.upf

ATOMIC_POSITIONS crystal
  Fe  -0.0000000000000000  0.0000000000000000  0.0000000000000000

K_POINTS automatic
  8 8 8  0 0 0

CELL_PARAMETERS bohr
  -2.7117569888379802  2.7117569888379802  2.7117569888379802
  2.7117569888379802  -2.7117569888379802  2.7117569888379802
  2.7117569888379802  2.7117569888379802  -2.7117569888379802
