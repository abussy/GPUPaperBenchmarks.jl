! Generated from the corresponding DFTK benchmark setup.
! DFTK uses Hartree; QE cutoffs and smearing below use Rydberg.
&CONTROL
  calculation = 'scf'
  prefix = 'zro2_primitive'
  pseudo_dir = './pseudo/'
  outdir = './out/'
  tprnfor = .true.
  tstress = .false.
  disk_io = 'none'
/

&SYSTEM
  ibrav = 0
  nat = 3
  ntyp = 2
  ecutwfc = 84.0000000000
  ecutrho = 336.0000000000
  nr1 = 45
  nr2 = 45
  nr3 = 45
  input_dft = 'PBE'
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 2.000000000000e-02
  nspin = 1
/

&ELECTRONS
  electron_maxstep = 10
  conv_thr = 0.0d0
  scf_must_converge = .false.
/

ATOMIC_SPECIES
  Zr  91.22400000  Zr.upf
  O  15.99900000  O.upf

ATOMIC_POSITIONS crystal
  Zr  0.0000000000000000  0.0000000000000000  -0.0000000000000000
  O  0.2500000000000000  0.2500000000000000  0.2500000000000000
  O  0.7500000000000000  0.7500000000000000  0.7500000000000000

K_POINTS automatic
  8 8 8  0 0 0

CELL_PARAMETERS bohr
  0.0000000000000000  4.7999043565494564  4.7999043565494564
  4.7999043565494564  0.0000000000000000  4.7999043565494564
  4.7999043565494564  4.7999043565494564  0.0000000000000000
